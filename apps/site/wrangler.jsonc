{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodejs-website",
  "compatibility_date": "2026-03-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "VINEXT_CACHE",
  //     "id": "<your-kv-namespace-id>"
  //   }
  // ]
}
