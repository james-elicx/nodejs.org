{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./cloudflare/worker-entrypoint.ts",
  "name": "nodejs-website",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "d48e2eb599d9aa075d5e682deaecc518",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "version_metadata": {
    // Used for Sentry and X-Cloudflare-Worker-Version-Id diagnostics.
    // See: https://docs.sentry.io/platforms/javascript/guides/cloudflare/#release-configuration-optional
    "binding": "CF_VERSION_METADATA",
  },
  "cache": { "enabled": true },
  "images": { "binding": "IMAGES" },
  "vars": {
    "VINEXT_BUILD_TIME_ISR": true,
    "NEXT_PUBLIC_STATIC_EXPORT_LOCALE": false,
  },
}
